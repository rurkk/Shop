# Скопируйте в .env.production с правами 0600 и заполните обязательные поля.
SHOP_DOMAIN=knitsew.ru
SHOP_PUBLIC_ORIGIN=https://knitsew.ru
SHOP_TLS_DIR=/opt/knitsew-production/tls
# Используется только при запуске с compose.prod.pilot.yaml.
SHOP_PILOT_HTPASSWD=/opt/knitsew-production/pilot.htpasswd

# Укажите образы backend и frontend из одного релиза.
SHOP_BACKEND_IMAGE=
SHOP_FRONTEND_IMAGE=

SHOP_DB_USER=shop
SHOP_DB_ADMIN_PASSWORD=
SHOP_DB_PASSWORD=
SHOP_S3_BUCKET=order-files
SHOP_S3_ACCESS_KEY=
SHOP_S3_SECRET_KEY=
SHOP_CODE_SECRET=
# Постоянный ключ шифрования TOTP. Сгенерируйте через openssl rand -hex 32.
SHOP_STAFF_TOTP_ENCRYPTION_KEY=
# Начальные администраторы в формате email=секрет через запятую.
SHOP_BOOTSTRAP_STAFF_TOTP_ACCOUNTS=

SHOP_SMTP_HOST=postbox.cloud.yandex.net
SHOP_SMTP_PORT=587
SHOP_MAIL_FROM=
SHOP_SMTP_USERNAME=
SHOP_SMTP_PASSWORD=

# Включите после готовности рабочего магазина, кассы и документов.
SHOP_YOOKASSA_ENABLED=false
SHOP_YOOKASSA_SHOP_ID=
SHOP_YOOKASSA_SECRET_KEY=

# Ключ и баланс из кабинета GenAPI. Включайте после проверки на тестовом заказе.
SHOP_SKETCH_GENAPI_ENABLED=false
SHOP_SKETCH_GENAPI_API_KEY=
